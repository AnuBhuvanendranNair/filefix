{
    "name": "anubit/filefix",
    "type": "typo3-cms-extension",
    "description": "Fileadmin housekeeping toolkit: detect MIME/content mismatches, find and remove unused files.",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Anu Bhuvanendran Nair",
            "role": "Developer"
        }
    ],
    "require": {
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-backend": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-extbase": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-fluid": "^12.4 || ^13.4 || ^14.0"
    },
    "suggest": {
        "typo3/cms-dashboard": "Dashboard widgets with unused-file statistics"
    },
    "autoload": {
        "psr-4": {
            "Anubit\\Filefix\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/public",
            "extension-key": "filefix"
        }
    }
}
